class MenuItem {
  String title;
  int price;

  MenuItem(this.title, this.price);

  String format() {
    return 'Price of menu $title is $price';
  }
}

class Pizza extends MenuItem {
  List<String> topping;

  Pizza(this.topping, super.title, super.price);

  @override
  String toString() {
    return '$topping $title $price';
  }
}
